{
  "_version": "1.49.0",
  "sap.app": {
    "id": "retcl.maintenanceplanner",
    "type": "application",
    "title": "Maintenance Planner",
    "description": "Schedule, track and review preventive maintenance and calibration routines",
    "dataSources": {
      "mainService": {
        "uri": "/maintenance/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "repair-jobs-display": {
          "semanticObject": "repair-jobs",
          "action": "display",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    },
    "applicationVersion": {
      "version": "1.0.0"
    },
    "i18n": "i18n/i18n.properties"
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "MaintenanceRecordsList",
          "target": "MaintenanceRecordsList"
        },
        {
          "pattern": "MaintenanceRecords({key}):?query:",
          "name": "MaintenanceRecordsObjectPage",
          "target": "MaintenanceRecordsObjectPage"
        }
      ],
      "targets": {
        "MaintenanceRecordsList": {
          "type": "Component",
          "id": "MaintenanceRecordsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "MaintenanceRecords",
              "liveMode": true,
              "navigation": {
                "MaintenanceRecords": {
                  "detail": {
                    "route": "MaintenanceRecordsObjectPage"
                  }
                }
              }
            }
          }
        },
        "MaintenanceRecordsObjectPage": {
          "type": "Component",
          "id": "MaintenanceRecordsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "MaintenanceRecords"
            }
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "sprint.service"
  }
}
