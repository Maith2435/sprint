{
  "name": "sprint",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.8"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch --profile hybrid",
    "dev-router": "node scripts/dev-router.mjs",
    "seed": "cds bind --exec -- node scripts/seed-data.js",
    "seed:demo": "cds bind --exec -- node scripts/seed-demo.js"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "hana",
        "pool": {
          "max": 25,
          "min": 0,
          "idleTimeoutMillis": 30000,
          "evictionRunIntervalMillis": 15000,
          "acquireTimeoutMillis": 30000,
          "testOnBorrow": true
        }
      },
      "auth": "dummy",
      "queue": false,
      "[production]": {
        "auth": "xsuaa"
      },
      "destinations": true
    }
  }
}
